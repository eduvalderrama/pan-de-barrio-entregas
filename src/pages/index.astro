---
import Layout from '../layouts/Layout.astro'
import ContactForm from '../components/ContactForm.astro'
import { site, whatsappHref } from '../config/site'
import { benefits, steps, testimonials, faq, trustPoints } from '../data/content'
---

<Layout>
  <section
    id="inicio"
    class="scroll-mt-20 bg-gradient-to-b from-wheat to-cream px-6 pt-10 pb-10 md:pt-14 md:pb-12"
  >
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <p class="eyebrow">{site.location}</p>
        <h1
          class="mt-2 font-display text-4xl leading-tight font-bold text-espresso sm:text-5xl"
        >
          Pan artesanal recién horneado, en la puerta de tu casa
        </h1>
        <p class="mt-5 max-w-xl text-lg text-muted">
          En <strong class="text-espresso">{site.name}</strong> horneamos cada mañana con masa
          madre e ingredientes locales. Pide por WhatsApp y recibe pan crujiente sin salir de
          casa.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#contacto" class="btn-primary text-center">Quiero mi pedido</a>
          <a href="#como-funciona" class="btn-secondary text-center">Ver cómo funciona</a>
        </div>
        <ul class="mt-8 space-y-2 text-muted" aria-label="Ventajas rápidas">
          {
            trustPoints.map((point) => (
              <li class="flex gap-2">
                <span class="font-bold text-amber-dark" aria-hidden="true">
                  ✓
                </span>
                {point}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mx-auto w-full max-w-lg lg:max-w-none">
        <img
          src="/hero-bread.svg"
          alt="Ilustración de pan artesanal recién horneado"
          width="480"
          height="400"
          class="drop-shadow-xl"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section id="beneficios" class="section-pad bg-wheat">
    <div class="mx-auto max-w-6xl">
      <header class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Beneficios</p>
        <h2 class="mt-2 font-display text-3xl font-bold text-espresso md:text-4xl">
          ¿Por qué elegir pan de barrio?
        </h2>
        <p class="mt-3 text-muted">
          Calidad de panadería de barrio con la comodidad de un mensaje y la entrega en tu
          horario.
        </p>
      </header>
      <ul class="mt-8 grid gap-5 sm:grid-cols-3">
        {
          benefits.map((item) => (
            <li class="rounded-2xl border border-crust/10 bg-white p-6 shadow-sm">
              <span class="text-3xl" aria-hidden="true">
                {item.icon}
              </span>
              <h3 class="mt-3 font-display text-xl font-semibold">{item.title}</h3>
              <p class="mt-2 text-sm text-muted">{item.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-7 text-center">
        <a href="#contacto" class="btn-primary">Armar mi pedido</a>
      </p>
    </div>
  </section>

  <section id="como-funciona" class="section-pad">
    <div class="mx-auto max-w-6xl">
      <header class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Cómo funciona</p>
        <h2 class="mt-2 font-display text-3xl font-bold text-espresso md:text-4xl">
          Tres pasos y listo el desayuno
        </h2>
      </header>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="rounded-2xl border border-crust/10 bg-white p-6">
              <span
                class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-amber text-sm font-bold text-white"
              >
                {i + 1}
              </span>
              <h3 class="mt-3 font-display text-lg font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-7 text-center">
        <a href="#contacto" class="btn-primary">Pedir por WhatsApp</a>
      </p>
    </div>
  </section>

  <section id="testimonios" class="section-pad bg-wheat">
    <div class="mx-auto max-w-6xl">
      <header class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Prueba social</p>
        <h2 class="mt-2 font-display text-3xl font-bold text-espresso md:text-4xl">
          Vecinos que ya desayunan mejor
        </h2>
      </header>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {
          testimonials.map((t) => (
            <li class="rounded-2xl border border-crust/10 bg-white p-6">
              <blockquote class="text-sm text-espresso italic">“{t.quote}”</blockquote>
              <footer class="mt-4 text-sm">
                <cite class="font-bold not-italic">{t.name}</cite>
                <span class="block text-muted">{t.place}</span>
              </footer>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="faq" class="section-pad-tight-bottom">
    <div class="mx-auto max-w-2xl">
      <header class="text-center">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="mt-2 font-display text-3xl font-bold text-espresso">Resolvemos tus dudas</h2>
      </header>
      <div class="mt-7 space-y-3">
        {
          faq.map((item) => (
            <details class="group rounded-xl border border-crust/15 bg-white">
              <summary class="cursor-pointer list-none px-4 py-3.5 font-semibold marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-center justify-between gap-2">
                  {item.q}
                  <span class="text-amber group-open:hidden">+</span>
                  <span class="hidden text-amber group-open:inline">−</span>
                </span>
              </summary>
              <p class="px-4 pt-0 pb-4 text-sm text-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-5 text-center">
        <a href="#contacto" class="btn-secondary">Otra pregunta · escríbenos</a>
      </p>
    </div>
  </section>

  <section id="contacto" class="section-pad-tight-top bg-wheat">
    <div class="mx-auto max-w-2xl">
      <header class="text-center">
        <p class="eyebrow">Contacto</p>
        <h2 class="mt-2 font-display text-3xl font-bold text-espresso">
          ¿Listo para oler pan recién horneado?
        </h2>
        <p class="mt-3 text-muted">
          Escríbenos por WhatsApp con tu zona y cuántas piezas necesitas. Te respondemos en
          minutos en horario de reparto.
        </p>
      </header>
      <div class="mt-5 text-center">
        <a
          href={whatsappHref()}
          class="btn-primary inline-flex px-8 py-3.5 text-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir WhatsApp
        </a>
        <p class="mt-2 text-sm text-muted">
          También puedes usar el formulario (demo). En producción se conectaría a email o CRM.
        </p>
      </div>
      <div class="mt-5">
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>
